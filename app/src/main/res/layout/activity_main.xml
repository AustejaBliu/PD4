<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="2dp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeTextType="uniform"
        android:background="#EEEEEE"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="#000000"
        tools:text="0" />

    <!-- Row 1: memory -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button android:id="@+id/btnMemoryClear" style="@style/CalcButton" android:text="@string/btn_memory_clear"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnMemoryRecall" style="@style/CalcButton" android:text="@string/btn_memory_recall"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnMemoryStore" style="@style/CalcButton" android:text="@string/btn_memory_store"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnMemoryAdd" style="@style/CalcButton" android:text="@string/btn_memory_add"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnMemorySubtract" style="@style/CalcButton" android:text="@string/btn_memory_subtract"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button android:id="@+id/btnBackspace" style="@style/CalcButton" android:text="@string/btn_backspace"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnClearEntry" style="@style/CalcButton" android:text="@string/btn_clear_entry"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnClear" style="@style/CalcButton" android:text="@string/btn_clear"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnNegate" style="@style/CalcButton" android:text="@string/btn_negate"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnSquareRoot" style="@style/CalcButton" android:text="@string/btn_square_root"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button android:id="@+id/btn7" style="@style/CalcButton" android:text="@string/btn_digit_7"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btn8" style="@style/CalcButton" android:text="@string/btn_digit_8"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btn9" style="@style/CalcButton" android:text="@string/btn_digit_9"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnDivide" style="@style/CalcButton" android:text="@string/btn_divide"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnPercent" style="@style/CalcButton" android:text="@string/btn_percent"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button android:id="@+id/btn4" style="@style/CalcButton" android:text="@string/btn_digit_4"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btn5" style="@style/CalcButton" android:text="@string/btn_digit_5"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btn6" style="@style/CalcButton" android:text="@string/btn_digit_6"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcButton" android:text="@string/btn_multiply"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
        <Button android:id="@+id/btnReciprocal" style="@style/CalcButton" android:text="@string/btn_reciprocal"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Rows 5-6: left 4 columns + tall "=" button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button android:id="@+id/btn1" style="@style/CalcButton" android:text="@string/btn_digit_1"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
                <Button android:id="@+id/btn2" style="@style/CalcButton" android:text="@string/btn_digit_2"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
                <Button android:id="@+id/btn3" style="@style/CalcButton" android:text="@string/btn_digit_3"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
                <Button android:id="@+id/btnSubtract" style="@style/CalcButton" android:text="@string/btn_subtract"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button android:id="@+id/btn0" style="@style/CalcButton" android:text="@string/btn_digit_0"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="2" />
                <Button android:id="@+id/btnDecimal" style="@style/CalcButton" android:text="@string/btn_decimal"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
                <Button android:id="@+id/btnAdd" style="@style/CalcButton" android:text="@string/btn_add"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_margin="2dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/btnEquals" style="@style/CalcButton" android:text="@string/btn_equals"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="2dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>